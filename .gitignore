# Exact publication allowlist. New files require deliberate review.
# Exclusions do not delete or relocate local data.
/*
!/.gitattributes
!/.github/
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/NOTICE
!/README.md
!/pyproject.toml
!/uv.lock
!/docs/
!/scripts/
!/src/
!/tests/

/.github/*
!/.github/workflows/

/.github/workflows/*
!/.github/workflows/ci.yml

/docs/*
!/docs/OBSERVATION.md
!/docs/SECURITY_APP.md

/scripts/*
!/scripts/check.py

/src/*
!/src/hermes_safeagents/

/src/hermes_safeagents/*
!/src/hermes_safeagents/__init__.py
!/src/hermes_safeagents/dashboard/
!/src/hermes_safeagents/desktop/
!/src/hermes_safeagents/decision_models.py
!/src/hermes_safeagents/gguf_metadata.py
!/src/hermes_safeagents/identity.py
!/src/hermes_safeagents/judge_adapter.py
!/src/hermes_safeagents/managed_monitor.py
!/src/hermes_safeagents/observation.py
!/src/hermes_safeagents/observe.py
!/src/hermes_safeagents/plugin.yaml
!/src/hermes_safeagents/replay_model.py
!/src/hermes_safeagents/replay_qev.py
!/src/hermes_safeagents/replay_safety.py
!/src/hermes_safeagents/service.py
!/src/hermes_safeagents/telemetry.py

/src/hermes_safeagents/dashboard/*
!/src/hermes_safeagents/dashboard/manifest.json
!/src/hermes_safeagents/dashboard/plugin_api.py

/src/hermes_safeagents/desktop/*
!/src/hermes_safeagents/desktop/plugin.js

# Defense in depth for credentials, generated files and runtime stores.
# Runtime state lives OUTSIDE this checkout; the state root still defaults to
# the legacy safeagents-eval trial directory during the repo split (marked
# TEMPORARY in the source).
.env
.env.*
.secrets
*.pem
*.key
id_rsa
id_ed25519
*.gguf
*.safetensors
*.bin
*.log
*.jsonl
*.pyc
*.pre-observation
__pycache__/
.venv*/
.uv-cache*/
.ruff_cache/
.pytest_cache/
src/hermes_safeagents/private-observation/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
